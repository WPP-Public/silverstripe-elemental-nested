{
  "name": "silverstripe-elemental-nested",
  "private": true,
  "engines": {
    "node": "^18.x"
  },
  "scripts": {
    "build": "rm -rf client/dist && NODE_ENV=production webpack --mode production --bail",
    "dev": "NODE_ENV=development webpack --progress",
    "watch": "NODE_ENV=development webpack --watch --progress",
    "test": "jest",
    "lint": "eslint client/src"
  },
  "dependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/modifiers": "^9.0.0",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "classnames": "^2.3.2",
    "prop-types": "^15.8.1",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "reactstrap": "^9.2.0"
  },
  "devDependencies": {
    "@silverstripe/eslint-config": "^2",
    "@silverstripe/webpack-config": "^3.4.0",
    "@testing-library/react": "^16.1.0",
    "babel-jest": "^29.2.2",
    "eslint": "^8.26.0",
    "jest": "^29.2.2",
    "jest-environment-jsdom": "^29.3.1",
    "webpack": "^5.74.0",
    "webpack-cli": "^5.0.0"
  },
  "jest": {
    "testEnvironment": "jsdom",
    "roots": [
      "client/src"
    ],
    "moduleDirectories": [
      "client/src",
      "vendor/silverstripe/admin/client/src",
      "vendor/dnadesign/silverstripe-elemental/client/src",
      "node_modules"
    ],
    "testMatch": [
      "**/tests/**/*-test.js"
    ],
    "transform": {
      ".*": "babel-jest"
    },
    "moduleNameMapper": {
      "^lib/Backend$": "<rootDir>/client/src/tests/mocks/Backend.js",
      "^lib/Config$": "<rootDir>/client/src/tests/mocks/Config.js",
      "^i18n$": "<rootDir>/client/src/tests/mocks/i18n.js",
      "^lib/getJsonErrorMessage$": "<rootDir>/client/src/tests/mocks/getJsonErrorMessage.js",
      "^containers/FormBuilderLoader/FormBuilderLoader$": "<rootDir>/client/src/tests/mocks/FormBuilderLoader.js"
    }
  }
}
