<?xml version="1.0"?>
<ruleset name="silverstripe-elemental-nested">
    <description>PHP_CodeSniffer ruleset for silverstripe-elemental-nested</description>
    <file>src</file>
    <file>tests</file>
    <!-- Global Page fixture for standalone test runs; see README -->
    <exclude-pattern>tests/standalone/*</exclude-pattern>
    <rule ref="PSR12" />
</ruleset>
